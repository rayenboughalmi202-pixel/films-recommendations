<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="#111111">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:paddingStart="20dp" android:paddingEnd="20dp" android:paddingTop="18dp" android:paddingBottom="14dp">
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:text="YAMI FILMS" android:textColor="#E50914" android:textSize="25sp" android:textStyle="bold" android:letterSpacing="0.08" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="CINEMA • DISCOVER • AI" android:textColor="#999999" android:textSize="9sp" />
    </LinearLayout>

    <ScrollView android:id="@+id/mainScroll" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:fillViewport="true" android:clipToPadding="false">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingBottom="18dp">
            <TextView android:id="@+id/headlineText" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Find your next favorite movie." android:textColor="#FFFFFF" android:textSize="27sp" android:textStyle="bold" android:lineSpacingExtra="2dp" />
            <TextView android:id="@+id/subtitleText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:layout_marginBottom="14dp"
                android:text="Search a film and let AI discover what you should watch next." android:textColor="#AAAAAA" android:textSize="13sp" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                <EditText android:id="@+id/searchInput" android:layout_width="0dp" android:layout_height="50dp" android:layout_weight="1"
                    android:backgroundTint="#555555" android:hint="Search movie title…" android:hintTextColor="#888888"
                    android:inputType="text" android:imeOptions="actionSearch" android:singleLine="true" android:textColor="#FFFFFF" android:textColorHint="#888888" />
                <Button android:id="@+id/searchButton" android:layout_width="wrap_content" android:layout_height="48dp"
                    android:layout_marginStart="8dp" android:backgroundTint="#E50914" android:text="SEARCH" android:textColor="#FFFFFF" />
            </LinearLayout>
            <TextView android:id="@+id/statusText" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="12dp" android:layout_marginBottom="6dp" android:textColor="#BBBBBB" android:textSize="12sp" />
            <TextView android:id="@+id/resultsLabel" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="SEARCH RESULTS"
                android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="14sp" android:layout_marginTop="5dp" />
            <ListView android:id="@+id/searchResults" android:layout_width="match_parent" android:layout_height="190dp"
                android:layout_marginTop="6dp" android:background="#1C1C1C" android:divider="#333333" android:dividerHeight="1dp" />
            <ImageView android:id="@+id/posterImage" android:layout_width="112dp" android:layout_height="160dp"
                android:layout_gravity="center_horizontal" android:layout_marginTop="12dp" android:contentDescription="Selected movie poster"
                android:scaleType="centerCrop" android:visibility="gone" />
            <Button android:id="@+id/recommendButton" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="12dp" android:backgroundTint="#E50914" android:enabled="false"
                android:text="✦  FIND SIMILAR MOVIES" android:textColor="#FFFFFF" />
            <Button android:id="@+id/favoriteButton" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="8dp" android:backgroundTint="#333333" android:enabled="false"
                android:text="♥  ADD TO MY LIST" android:textColor="#FFFFFF" />
            <TextView android:id="@+id/recLabel" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp"
                android:text="AI RECOMMENDATIONS" android:textColor="#FFFFFF" android:textSize="14sp" android:textStyle="bold" />
            <TextView android:id="@+id/recommendationsText" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:minHeight="110dp" android:layout_marginTop="8dp" android:padding="12dp" android:background="#1C1C1C"
                android:scrollbars="vertical" android:textColor="#EEEEEE" android:textSize="14sp" />
        </LinearLayout>
    </ScrollView>

    <LinearLayout android:id="@+id/navBar" android:layout_width="match_parent" android:layout_height="62dp" android:orientation="horizontal"
        android:background="#080808" android:gravity="center" android:weightSum="4">
        <Button android:id="@+id/navHome" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:backgroundTint="#252525" android:text="⌂&#10;HOME" android:textColor="#E50914" android:textSize="10sp" />
        <Button android:id="@+id/navSearch" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:backgroundTint="#080808" android:text="⌕&#10;SEARCH" android:textColor="#BBBBBB" android:textSize="10sp" />
        <Button android:id="@+id/navFavorites" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:backgroundTint="#080808" android:text="♥&#10;MY LIST" android:textColor="#BBBBBB" android:textSize="10sp" />
        <Button android:id="@+id/navSettings" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:backgroundTint="#080808" android:text="⚙&#10;SETTINGS" android:textColor="#BBBBBB" android:textSize="10sp" />
    </LinearLayout>
</LinearLayout>
